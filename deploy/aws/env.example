# /etc/raddit/<env>.env — 같은 환경의 두 서비스가 공유. 비밀값은 서버에만 둔다.
# 포트: dev = 4321/8001, prod = 4322/8002 (Caddyfile 과 일치시킬 것)
WEB_PORT=4321
RPC_PORT=8001
REDDIT_RPC_URL=http://127.0.0.1:8001
# 같은 값을 RPC_KEY(파이썬)·REDDIT_RPC_KEY(웹) 양쪽에
RPC_KEY=
REDDIT_RPC_KEY=
RADDIT_DB_PATH=/var/lib/raddit/dev/raddit.db
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
